---
interface Props {
  /** Button label. Default: "Let's talk" */
  label?: string;
  /** Extra class names for the trigger button */
  class?: string;
}
const { label = "Let's talk", class: className } = Astro.props;
---

<button
  type="button"
  data-cal-link="me/rendez-vous-de-15-min"
  data-cal-namespace="rendez-vous-de-15-min"
  data-cal-config='{"layout":"week_view","useSlotsViewOnSmallScreen":"true"}'
  class:list={[className]}
>
  <slot name="trigger">{label}</slot>
</button>

<script is:inline>
  (function (C, A, L) {
    let p = function (a, ar) {
      a.q.push(ar);
    };
    let d = C.document;
    C.Cal =
      C.Cal ||
      function () {
        let cal = C.Cal;
        let ar = arguments;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          d.head.appendChild(d.createElement("script")).src = A;
          cal.loaded = true;
        }
        if (ar[0] === L) {
          const api = function () {
            p(api, arguments);
          };
          const namespace = ar[1];
          api.q = api.q || [];
          if (typeof namespace === "string") {
            cal.ns[namespace] = cal.ns[namespace] || api;
            p(cal.ns[namespace], ar);
            p(cal, ["initNamespace", namespace]);
          } else p(cal, ar);
          return;
        }
        p(cal, ar);
      };
  })(window, "https://cal.maujogue.fr/embed/embed.js", "init");

  Cal("init", "rendez-vous-de-15-min", { origin: "https://cal.maujogue.fr" });
  Cal.ns["rendez-vous-de-15-min"]("ui", {
    hideEventTypeDetails: false,
    layout: "week_view",
  });
</script>
