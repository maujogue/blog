---
import "@n8n/chat/style.css";

interface Props {
  /** n8n Chat Trigger production webhook URL */
  webhookUrl?: string;
}

const {
  webhookUrl = "https://n8n.maujogue.fr/webhook/f238b2a7-b765-4f53-8b43-bc6f03c25973/chat",
} = Astro.props;
---

<div id="n8n-chat" data-webhook-url={webhookUrl}></div>

<script>
  import { createChat } from "@n8n/chat";

  const target = document.querySelector<HTMLElement>("#n8n-chat");
  const webhookUrl = target?.dataset.webhookUrl;

  if (webhookUrl) {
    createChat({
      webhookUrl,
      target: "#n8n-chat",
      mode: "window",
      loadPreviousSession: true,
      initialMessages: [
        "Hi there! 👋",
        "Ask me anything about Mathis or his writing.",
      ],
      i18n: {
        en: {
          title: "Hi there! 👋",
          subtitle: "Ask me anything about this blog.",
          footer: "",
          getStarted: "New Conversation",
          inputPlaceholder: "Type your question…",
          closeButtonTooltip: "Close chat",
        },
      },
    });
  }
</script>

<style is:global>
  /*
    The widget's layout root is a <main> element, so the global
    `main { flex-1 py-32 }` rule in global.css would add 8rem of dead space
    inside the chat window. Reset it for the widget only.
  */
  #n8n-chat main.chat-layout {
    padding: 0;
  }

  :root {
    /* monochrome palette, matching the site */
    --chat--color--primary: #171717;
    --chat--color--primary-shade-50: #262626;
    --chat--color--primary--shade-100: #404040;
    --chat--color--secondary: #171717;
    --chat--color-secondary-shade-50: #262626;
    --chat--color-typing: #737373;

    --chat--font-family: var(--font-sans);
    --chat--font-family--monospace: var(--font-mono);
    --chat--border-radius: 0.375rem;

    --chat--window--width: 380px;
    --chat--window--height: 560px;
    --chat--window--border: 1px solid rgb(0 0 0 / 0.15);
    --chat--toggle--size: 56px;
    --chat--toggle--color: #fafafa;

    --chat--heading--font-size: 1.5em;
    --chat--message--font-size: 0.9rem;
    --chat--message--user--background: #171717;
    --chat--message--user--color: #fafafa;
    --chat--message--bot--background: #ffffff;
    --chat--message--bot--color: #171717;
    --chat--message--bot--border: 1px solid rgb(0 0 0 / 0.1);

    --chat--body--background: #f5f5f5;
    --chat--header--background: #171717;
    --chat--header--color: #fafafa;
    --chat--footer--background: #f5f5f5;
    --chat--input--send--button--color: #171717;
    --chat--input--send--button--background-hover: #f5f5f5;
    --chat--input--send--button--color-hover: #000000;
  }

  html.dark {
    --chat--color--primary: #fafafa;
    --chat--color--primary-shade-50: #e5e5e5;
    --chat--color--primary--shade-100: #d4d4d4;
    --chat--color--secondary: #fafafa;
    --chat--color-secondary-shade-50: #e5e5e5;
    --chat--color-typing: #a3a3a3;

    --chat--window--border: 1px solid rgb(255 255 255 / 0.2);
    --chat--toggle--color: #171717;

    --chat--body--background: #0a0a0a;
    --chat--header--background: #171717;
    --chat--header--color: #fafafa;
    --chat--close--button--color-hover: #fafafa;

    --chat--message--user--background: #fafafa;
    --chat--message--user--color: #171717;
    --chat--message--bot--background: #171717;
    --chat--message--bot--color: #fafafa;
    --chat--message--bot--border: 1px solid rgb(255 255 255 / 0.15);
    --chat--message--pre--background: rgb(255 255 255 / 0.08);

    --chat--input--background: #171717;
    --chat--input--container--background: #171717;
    --chat--input--text-color: #fafafa;
    --chat--input--send--button--background: #171717;
    --chat--input--send--button--color: #fafafa;
    --chat--input--send--button--background-hover: #262626;
    --chat--input--send--button--color-hover: #ffffff;
    --chat--input--file--button--background: #171717;
    --chat--input--file--button--color: #fafafa;

    --chat--footer--background: #171717;
    --chat--footer--color: #fafafa;
    --chat--footer--border-top: 1px solid rgb(255 255 255 / 0.15);

    --chat--button--color--primary: #171717;
    --chat--button--background--primary: #fafafa;
    --chat--button--background--primary--hover: #e5e5e5;
  }
</style>
