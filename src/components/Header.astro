---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";
import { LANGS } from "@i18n/ui";
import { getLang, localizePath, useTranslations } from "@i18n/utils";

const lang = getLang(Astro);
const t = useTranslations(lang);

const menuItemClass =
  "flex w-full items-center gap-2 rounded-sm px-2 py-1.5 text-left hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white";
---

<header transition:persist>
  <Container>
    <div class="flex flex-wrap justify-between gap-y-2">
      <Link href={localizePath("/", lang)} underline={false}>
        <div class="font-semibold">
          {SITE.TITLE}&nbsp;🔬
        </div>
      </Link>
      <nav class="flex items-center gap-1 text-sm">
        <Link href={localizePath("/blog", lang)}>{t("nav.blog")}</Link>
        <span>
          {`/`}
        </span>
        <Link href={localizePath("/timeline", lang)}>{t("nav.timeline")}</Link>
        <span>
          {`/`}
        </span>
        <button
          id="magnifying-glass"
          aria-label={t("nav.search")}
          class="flex items-center rounded-sm border border-black/15 bg-neutral-100 px-2 py-1 text-xs transition-colors duration-300 ease-in-out hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-white/20 dark:bg-neutral-900 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white"
        >
          <svg
            height="16"
            stroke-linejoin="round"
            viewBox="0 0 16 16"
            width="16"
            style="color: currentcolor;"
            ><path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M3.5 7C3.5 5.067 5.067 3.5 7 3.5C8.933 3.5 10.5 5.067 10.5 7C10.5 7.88461 10.1718 8.69256 9.63058 9.30876L9.30876 9.63058C8.69256 10.1718 7.88461 10.5 7 10.5C5.067 10.5 3.5 8.933 3.5 7ZM9.96544 11.0261C9.13578 11.6382 8.11014 12 7 12C4.23858 12 2 9.76142 2 7C2 4.23858 4.23858 2 7 2C9.76142 2 12 4.23858 12 7C12 8.11014 11.6382 9.13578 11.0261 9.96544L14.0303 12.9697L14.5607 13.5L13.5 14.5607L12.9697 14.0303L9.96544 11.0261Z"
              fill="currentColor"></path></svg
          >
          &nbsp;{t("nav.search")}
        </button>

        <div
          class="ml-1 flex items-center rounded-sm border border-black/15 text-xs dark:border-white/20"
          role="group"
          aria-label={t("nav.language")}
        >
          {
            LANGS.map((l) => (
              <a
                href={localizePath(Astro.url.pathname, l)}
                hreflang={l}
                lang={l}
                data-lang-switch={l}
                data-astro-reload
                aria-current={l === lang ? "true" : undefined}
                class:list={[
                  "px-2 py-1 uppercase transition-colors duration-300 ease-in-out hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white",
                  l === lang &&
                    "bg-black/5 font-semibold text-black dark:bg-white/5 dark:text-white",
                ]}
              >
                {l}
              </a>
            ))
          }
        </div>

        <div id="theme-menu" class="relative">
          <button
            id="theme-menu-button"
            aria-label={t("theme.label")}
            aria-haspopup="menu"
            aria-expanded="false"
            aria-controls="theme-menu-list"
            class="flex size-[26px] items-center justify-center rounded-sm border border-black/15 transition-colors duration-300 ease-in-out hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white"
          >
            <svg
              data-theme-icon="light"
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="hidden"
            >
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <svg
              data-theme-icon="dark"
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="hidden"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <svg
              data-theme-icon="system"
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </button>
          <div
            id="theme-menu-list"
            role="menu"
            aria-labelledby="theme-menu-button"
            hidden
            class="absolute right-0 top-full z-50 mt-1 w-32 rounded-sm border border-black/15 bg-neutral-100 p-1 text-xs shadow-lg dark:border-white/20 dark:bg-neutral-900"
          >
            <button id="light-theme-button" role="menuitemradio" class={menuItemClass}>
              {t("theme.light")}
            </button>
            <button id="dark-theme-button" role="menuitemradio" class={menuItemClass}>
              {t("theme.dark")}
            </button>
            <button id="system-theme-button" role="menuitemradio" class={menuItemClass}>
              {t("theme.system")}
            </button>
          </div>
        </div>
      </nav>
    </div>
  </Container>
</header>
