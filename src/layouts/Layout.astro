---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Pagefind from "@components/PageFind.astro";
import { SITE, CF_ANALYTICS_TOKEN } from "@consts";
import { getLang } from "@i18n/utils";

type Props = {
  title: string;
  description: string;
  /** Path of the canonical page, when it isn't this one. */
  canonical?: string;
};

const { title, description, canonical } = Astro.props;
const lang = getLang(Astro);
---

<!doctype html>
<html lang={lang}>
  <head>
    <Head
      title={`${title} | ${SITE.TITLE}`}
      description={description}
      canonical={canonical}
    />
    {import.meta.env.PROD && CF_ANALYTICS_TOKEN && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: CF_ANALYTICS_TOKEN })}
      ></script>
    )}
  </head>
  <body>
    <noscript>
      <style>
        .animate{
          opacity:1;
          translate: var(--tw-translate-x) calc(var(--spacing) * 0);
        }
      </style>
    </noscript>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <Pagefind />
  </body>
</html>
