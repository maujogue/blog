---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SITE, SOCIALS } from "@consts";
import { NOW } from "@data/now";
import { DATE_LOCALES } from "@i18n/ui";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import {
  getLang,
  getLocalizedEntries,
  langParams,
  localizePath,
  useTranslations,
} from "@i18n/utils";

export function getStaticPaths() {
  return langParams();
}

const lang = getLang(Astro);
const t = useTranslations(lang);

const blog = (await getLocalizedEntries("blog", lang)).slice(
  0,
  SITE.NUM_POSTS_ON_HOMEPAGE,
);

const nowMonth = new Date(`${NOW.month}-01T00:00:00`).toLocaleDateString(
  DATE_LOCALES[lang],
  { month: "long", year: "numeric" },
);
---

<Layout title={t("home.title")} description={t("home.description")}>
  <Container>
    <aside data-pagefind-ignore>
      <h1 class="font-semibold text-black dark:text-white">Hey! 🔬</h1>
      <div class="space-y-16">
        <section>
          <article class="space-y-4">
            <p>
              {t("home.intro1")} <br />
              {t("home.intro2")} <br />
              {t("home.intro3")}
            </p>
            <p class="animate">{t("home.intro4")}</p>
          </article>
          <div class="animate mt-4 text-sm">
            <Link href={localizePath("/timeline", lang)}>
              {t("home.timelineLink")} →
            </Link>
          </div>
        </section>

        <section class="animate space-y-4">
          <h2 class="font-semibold text-black dark:text-white">
            {t("home.now", { month: nowMonth })}
          </h2>
          <ul class="list-disc space-y-2 pl-5">
            {
              NOW.items.map((item) => (
                <li>
                  <span class="font-medium text-black dark:text-white">
                    {item.label[lang]}
                  </span>
                  {lang === "fr" ? " : " : ": "}
                  {item.href ? (
                    <Link href={localizePath(item.href, lang)} class="inline">
                      {item.text[lang]}
                    </Link>
                  ) : (
                    item.text[lang]
                  )}
                </li>
              ))
            }
          </ul>
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="font-semibold text-black dark:text-white">
              {t("home.latestPosts")}
            </h2>
            <Link href={localizePath("/blog", lang)}>{t("home.allPosts")}</Link>
          </div>
          <ul class="not-prose flex flex-col gap-4">
            {
              blog.map((post) => (
                <li>
                  <ArrowCard item={post} />
                </li>
              ))
            }
          </ul>
        </section>

        <section class="animate space-y-4">
          <h2 class="font-semibold text-black dark:text-white">
            {t("home.connect")}
          </h2>
          <article>
            <p>{t("home.connectText")}</p>
          </article>
          <ul class="not-prose flex flex-wrap gap-2">
            <li class="flex gap-x-2 text-nowrap">
              <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.TITLE}`}>
                {SITE.EMAIL}
              </Link>
              {"/"}
            </li>
            {
              SOCIALS.map((SOCIAL) => (
                <li class="flex gap-x-2 text-nowrap">
                  <Link
                    href={SOCIAL.HREF}
                    external
                    aria-label={`${SITE.TITLE} on ${SOCIAL.NAME}`}
                  >
                    {SOCIAL.NAME}
                  </Link>
                  {"/"}
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </aside>
  </Container>
</Layout>
