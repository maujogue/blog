---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SITE, SOCIALS } from "@consts";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import {
  getLang,
  getLocalizedEntries,
  langParams,
  localizePath,
  useTranslations,
} from "@i18n/utils";

export function getStaticPaths() {
  return langParams();
}

const lang = getLang(Astro);
const t = useTranslations(lang);

const blog = (await getLocalizedEntries("blog", lang)).slice(
  0,
  SITE.NUM_POSTS_ON_HOMEPAGE,
);

const projects = (await getLocalizedEntries("projects", lang)).slice(
  0,
  SITE.NUM_PROJECTS_ON_HOMEPAGE,
);
---

<Layout title={t("home.title")} description={t("home.description")}>
  <Container>
    <aside data-pagefind-ignore>
      <h1 class="font-semibold text-black dark:text-white">Hey! 🔬</h1>
      <div class="space-y-16">
        <section>
          <article class="space-y-4">
            <span>
              <p>
                {t("home.intro1")} <br />
                {t("home.intro2")}
              </p>
            </span>
            <span class="animate">
              <p>{t("home.intro3")}</p>
            </span>
          </article>
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="font-semibold text-black dark:text-white">
              {t("home.latestPosts")}
            </h2>
            <Link href={localizePath("/blog", lang)}>{t("home.allPosts")}</Link>
          </div>
          <ul class="not-prose flex flex-col gap-4">
            {
              blog.map((post) => (
                <li>
                  <ArrowCard item={post} />
                </li>
              ))
            }
          </ul>
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="font-semibold text-black dark:text-white">
              {t("home.recentProjects")}
            </h2>
            <Link href={localizePath("/projects", lang)}>
              {t("home.allProjects")}
            </Link>
          </div>
          <ul class="not-prose flex flex-col gap-4">
            {
              projects.map((project) => (
                <li>
                  <ArrowCard item={project} />
                </li>
              ))
            }
          </ul>
        </section>

        <section class="animate space-y-4">
          <h2 class="font-semibold text-black dark:text-white">
            {t("home.connect")}
          </h2>
          <article>
            <p>{t("home.connectText")}</p>
          </article>
          <ul class="not-prose flex flex-wrap gap-2">
            <li class="flex gap-x-2 text-nowrap">
              <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.TITLE}`}>
                {SITE.EMAIL}
              </Link>
              {"/"}
            </li>
            {
              SOCIALS.map((SOCIAL) => (
                <li class="flex gap-x-2 text-nowrap">
                  <Link
                    href={SOCIAL.HREF}
                    external
                    aria-label={`${SITE.TITLE} on ${SOCIAL.NAME}`}
                  >
                    {SOCIAL.NAME}
                  </Link>
                  {"/"}
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </aside>
  </Container>
</Layout>
